{
  "redirects": [
    { "source": "/home-winnipeg", "destination": "/winnipeg", "permanent": true },
    { "source": "/home-winnipeg/", "destination": "/winnipeg", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/inquiry", "destination": "/inquiry.html" },
    { "source": "/brandon", "destination": "/brandon.html" },
    { "source": "/winnipeg", "destination": "/winnipeg.html" },
    { "source": "/:page.html.md", "destination": "/:page.md" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
